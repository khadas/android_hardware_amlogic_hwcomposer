cc_defaults {
    name: "libmeson_hwc3_defaults",

    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wformat",
        "-Wthread-safety",
        "-Wunused",
        "-Wunreachable-code",
        "-Wconversion",
        "-DLOG_TAG=\"composer3\"",
    ],

    shared_libs: [
        "android.hardware.graphics.composer@2.1-resources",
        "android.hardware.graphics.composer@2.2-resources",
        "android.hardware.graphics.composer3-V1-ndk",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@4.0",
        "libbase",
        "libbinder",
        "libcutils",
        "libbinder_ndk",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "libhwc2on1adapter",
        "libhwc2onfbadapter",
        "liblog",
        "libsync",
        "libutils",
        "libamgralloc_ext",
        "libdrm",
        "libjsoncpp",
        "libui",
    ],

    static_libs: [
        "libaidlcommonsupport",
    ],
}

filegroup {
    name: "meson_hwc3_sources",
    srcs: [
        "Common.cpp",
        "Composer.cpp",
        "ComposerResources.cpp",
//        "ComposerClient.cpp",
        "HwcHal.cpp",
        "Main.cpp",
    ],
}

cc_binary {
    name: "android.hardware.graphics.composer@3.0-service.droidlogic",
    defaults: [
        "libmeson_hwc3_defaults",
    ],

    vendor: true,
    relative_install_path: "hw",
    srcs: [
        ":meson_hwc3_sources",
    ],

    vintf_fragments: ["android.hardware.graphics.composer@3.0-service.droidlogic.xml"],
    init_rc: ["android.hardware.graphics.composer@3.0-service.droidlogic.rc"],

}
