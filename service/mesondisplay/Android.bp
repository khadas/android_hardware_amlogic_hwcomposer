// *** THIS PACKAGE HAS SPECIAL LICENSING CONDITIONS.  PLEASE
//     CONSULT THE OWNERS AND opensource-licensing@google.com BEFORE
//     DEPENDING ON IT IN YOUR PROJECT. ***
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_hwcomposer_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   legacy_by_exception_only (by exception only)
    //   legacy_proprietary (by exception only)
    default_applicable_licenses: ["hardware_amlogic_hwcomposer_license"],
}

bootstrap_go_package {
    name: "mesondisplay",
    pkgPath: "android/soong/hwc_mesondisplay",
    deps: [
        "blueprint",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
        "blueprint-bootstrap",
        "soong-cc-config"
    ],
    srcs: [
        "mesondisplay.go",
    ],

    pluginFor: ["soong_build"],
}

hwc_mesondisplay_go_defaults {
    name: "mesondisplay_go_defaults",
}

cc_library_static {
    // This is for recovery mode static lib
    name: "libmeson_display_adapter_local_static",
    defaults: [
    "mesondisplay_go_defaults"
    ],
    vendor_available: true,
    recovery_available: true,

    cflags: [
        "-DRECOVERY_MODE",
        "-DLOG_TAG=\"MesonDisplay\"",
    ],
    srcs: [
        "adapter/DisplayAdapterRecovery.cpp",
        "adapter/DisplayAdapterCommon.cpp",
    ],

    local_include_dirs: [
        "include",
        "adapter",
    ],


    shared_libs: [
        "liblog",
        "libcutils",
    ],

    export_static_lib_headers: [
        "libjsoncpp",
    ],

    export_include_dirs: [
        "include",
        "adapter",
    ],
}

cc_library_static {
    name: "meson_display.adapter_local_static",
    defaults: [
    "mesondisplay_go_defaults"
    ],
    vendor: true,

    cflags: [
        "-Werror",
        "-Wall",
        "-DLOG_TAG=\"MesonDisplayServer\"",
    ],

    srcs: [
        "adapter/DisplayAdapterLocal.cpp",
        "adapter/DisplayAdapterCommon.cpp",
    ],

    export_include_dirs: [
        "include",
        "adapter",
    ],

    shared_libs: [
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.mapper@4.0",
        "vendor.amlogic.display.meson_display_ipc@1.0",
        "libamgralloc_ext",
        "libhidlbase",
        "liblog",
        "libhardware",
        "libcutils",
        "libutils",
        "libdrm",
        "libion",
        "libvideotunnel",
        "libmeson_mode_policy",
    ],

    static_libs: [
        "mesondisplay.common_static",
        "hwc.common_static",
        "hwc.composition_static",
        "hwc.postprocessor_static",
        "hwc.vt_static",
        "hwc.display_static",
        "hwc.utils_static",
        "hwc.base_static",
        "hwc.composer_static",
        "omxutil.static",
        "hwc.uvm_static",
    ],


    export_static_lib_headers: [
        "libjsoncpp",
    ],

}

cc_library_shared {
    // This is for meson display client
    name: "libwhiteboard_adapter.amlogic",
    defaults: ["mesondisplay_go_defaults"],
    vendor_available: true,

    cflags: [
        "-Werror",
        "-Wall",
        "-DLOG_TAG=\"WhiteBoard\"",
    ],
    srcs: [
        "whiteboard/whiteboard.cpp",
    ],
    shared_libs: [
        "libmeson_display_adapter_remote",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.mapper@4.0",
        "liblog",
        "libhardware",
        "libcutils",
        "libutils",
        "libhidlbase",
        "libamgralloc_ext",
    ],
    export_include_dirs: [
        "include",
        "adapter",
        "whiteboard",
    ],
    static_libs: [
        "libjsoncpp",
    ],
}

cc_library_shared {
    // This is for meson display client
    name: "libmeson_display_adapter_remote",
    defaults: [
    "mesondisplay_go_defaults"
    ],
    vendor_available: true,

    cflags: [
        "-Werror",
        "-Wall",
        "-DLOG_TAG=\"MesonDisplayClient\"",
    ],

    srcs: [
        "adapter/DisplayAdapterRemote.cpp",
        "adapter/DisplayAdapterCommon.cpp",
        "adapter/DisplayClient.cpp",
    ],

    export_include_dirs: [
        "include",
        "adapter",
    ],

    shared_libs: [
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.mapper@4.0",
        "liblog",
        "libhardware",
        "libcutils",
        "libutils",
        "libhidlbase",
        "libamgralloc_ext",
    ],

    header_libs: [
        "hwc.utils_log",
    ],


    export_static_lib_headers: [
        "libjsoncpp",
    ],

    static_libs: [
        "vendor.amlogic.display.meson_display_ipc@1.0",
    ],
}

cc_library_shared {
    // This is for meson display server
    name: "libmeson_display_service",
    defaults: [
    "mesondisplay_go_defaults"
    ],
    vendor: true,

    cflags: [
        "-DLOG_TAG=\"MesonDisplayServer\""
    ],

    srcs: [
        "service/DisplayService.cpp",
        "adapter/DisplayAdapterCommon.cpp",
    ],

    shared_libs: [
        "libamgralloc_ext",
        "vendor.amlogic.display.meson_display_ipc@1.0",
        "libhidlbase",
        "libui",
        "liblog",
        "libcutils",
        "libutils",
        "libbase",
        "libion",
    ],

    static_libs: [
        "mesondisplay.common_static",
        "hwc.utils_static",
    ],


    export_include_dirs: [
        "include",
        "service",
    ],
}
