package {
    default_applicable_licenses: ["hardware_amlogic_hwcomposer_license"],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
// See: http://go/android-license-faq
license {
    name: "hardware_amlogic_hwcomposer_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-GPL-2.0",
        "legacy_by_exception_only", // by exception only
        "legacy_proprietary", // by exception only
    ],
    license_text: [
        "LICENSE",
    ],
}

bootstrap_go_package {
    name: "hwcomposer_aidl",
    pkgPath: "android/soong/hw_composer_aidl",
    deps: [
        "blueprint",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
        "blueprint-bootstrap",
        "soong-cc-config"
    ],
    srcs: [
        "hwcomposer_aidl.go",
    ],

    pluginFor: ["soong_build"],
}

hw_composer_aidl_go_defaults {
    name: "composer_aidl_go_defaults",
}

soong_config_module_type {
    name: "meson_hwc_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "meson_hwc",

    bool_variables: [
        "hwc_release",
        "enable_keystone_correction",
        "enable_video_aisr",
        "enable_video_aipq",
        "enable_video_aiface",
        "enable_aidl",
        "enable_virtual_layer",
    ],

    value_variables: [
        "android_platform_sdk_extension_version",
    ],

    properties: [
        "cflags",
        "srcs",
        "shared_libs",
    ],
}

soong_config_bool_variable {
    name: "hwc_release",
}

soong_config_bool_variable {
    name: "enable_keystone_correction",
}

soong_config_bool_variable {
    name: "enable_video_aisr",
}

soong_config_bool_variable {
    name: "enable_aidl",
}

soong_config_bool_variable {
    name: "enable_video_aipq",
}

soong_config_bool_variable {
    name: "enable_video_aiface",
}

meson_hwc_cc_defaults {
    name: "hwcomposer_cc_defaults",
    vendor: true,

    soong_config_variables: {
        hwc_release: {
            cflags: ["-DHWC_RELEASE=1"],
        },

        enable_keystone_correction: {
            cflags: [
                "-DHWC_ENABLE_KEYSTONE_CORRECTION",
            ],

            shared_libs: [
                "libkeystonecorrection",
            ],
        },

        enable_video_aisr: {
            cflags: ["-DENABLE_VIDEO_AISR"],
        },

        enable_video_aipq: {
            cflags: ["-DENABLE_VIDEO_AIPQ"],
        },

        enable_video_aiface: {
            cflags: ["-DENABLE_VIDEO_AIFACE"],
        },

        enable_aidl: {
            cflags: ["-DENABLE_AIDL"],
        },

        android_platform_sdk_extension_version: {
            cflags: ["-DANDROID_PLATFORM_SDK_EXTENSION_VERSION=%s"],
        },

        enable_virtual_layer: {
            cflags: ["-DENABLE_VIRTUAL_LAYER"],
        },
    },

    product_variables: {
        platform_sdk_version: {
            cflags: ["-DPLATFORM_SDK_VERSION=%d"],
        },
    },

    shared_libs: [
        "libdrm",
        "libui",
        "libbase",
        "libdl",
        "liblog",
        "libutils",
        "libcutils",
        "libsync",
        "libion",
        "libhardware",
        "libhidlbase",
        "libge2d",
        "libvideotunnel",
        "libEGL",
        "libGLESv1_CM",
        "libGLESv2",
        "libamgralloc_ext",
        "libmeson_mode_policy",
        "vendor.amlogic.hardware.systemcontrol@1.0",
        "vendor.amlogic.hardware.systemcontrol@1.1",
        "libpng",
        "libz",
    ],
}
