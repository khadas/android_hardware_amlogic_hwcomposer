package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_hwcomposer_license"
    // to get the below license kinds:
    //   legacy_by_exception_only (by exception only)
    //   legacy_proprietary (by exception only)
    default_applicable_licenses: ["hardware_amlogic_hwcomposer_license"],
}

cc_binary {
    name: "vdin1test",
    proprietary: true,
    shared_libs: [
        "liblog",
        "libcutils",
        "libui",
        "libamgralloc_ext",
    ],

    static_libs: [
        "hwc.utils_static",
    ],
    include_dirs: ["hardware/amlogic/gralloc/amlogic"],

    srcs: ["display_vdin1.cpp"],

}

cc_binary {
    name: "test_composition",
    vendor: true,
    defaults: ["hwcomposer_cc_defaults"],
    // !!! static lib sequence is serious, donot change it.
    static_libs: [
        "mesondisplay.common_static",
        "libjsoncpp",
        "meson_display.adapter_local_static",
        "hwc.composer_static",
        "hwc.common_static",
        "hwc.composition_static",
        "hwc.postprocessor_static",
        "hwc.vt_static",
        "hwc.display_static",
        "hwc.base_static",
        "hwc.utils_static",
        "omxutil.static",
    ],
    shared_libs: [
        "libui",
        "libpng",
        "libz",
        "libEGL",
        "libGLESv1_CM",
        "libGLESv2",
    ],
    srcs: ["Composition_test.cpp"],
}



cc_binary {
    name: "ge2d_test",
    vendor: true,
    // !!! static lib sequence is serious, donot change it.
    static_libs: [
        "hwc.utils_static",

    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libion",
        "libui",
        "libpng",
        "libz",
        "libge2d-2.0",
        "libamgralloc_ext",
    ],
    include_dirs: [
        "vendor/amlogic/common/system/libge2d/v2/include",
        "hardware/amlogic/gralloc/amlogic",
    ],
    srcs: ["ge2d_test.cpp"],
    cflags: [
        "-Wno-deprecated-declarations",
        "-Wno-unused-parameter",
        "-Wno-format",
        "-Wno-c++20-extensions",
        "-Wno-format-extra-args",
        "-Wno-error=unused-parameter",
    ],
}
