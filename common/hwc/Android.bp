// *** THIS PACKAGE HAS SPECIAL LICENSING CONDITIONS.  PLEASE
//     CONSULT THE OWNERS AND opensource-licensing@google.com BEFORE
//     DEPENDING ON IT IN YOUR PROJECT. ***
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_hwcomposer_license"
    // to get the below license kinds:
    //   legacy_by_exception_only (by exception only)
    //   legacy_proprietary (by exception only)
    default_applicable_licenses: ["hardware_amlogic_hwcomposer_license"],
}

soong_config_module_type {
    name: "meson_hwc_hwc_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "meson_hwc",
    bool_variables: [
        "enable_headless_mode",
        "enable_vt_hwVsync",
     ],

    properties: [
        "cflags",
    ],
}

soong_config_bool_variable {
    name: "enable_headless_mode",
}

soong_config_bool_variable {
    name: "enable_vt_hwVsync",
}

meson_hwc_hwc_cc_defaults {
    name: "hwcomposer_hwc_cc_defaults",
    defaults: [
        "hwcomposer_cc_defaults",
    ],

    soong_config_variables: {
        enable_headless_mode: {
            cflags: [
                "-DHWC_ENABLE_HEADLESS_MODE",
                "-DHWC_HEADLESS_REFRESHRATE=5",
            ],
       },

        enable_vt_hwVsync: {
            cflags: ["-DHWC_VT_HW_VSYNC"],
        },
    },
}

cc_library_static {
    name: "hwc.common_static",
    defaults: ["hwcomposer_hwc_cc_defaults"],
    vendor: true,

    srcs: [
        "HwcVsync.cpp",
        "HwcPowerMode.cpp",
        "HwcModeMgr.cpp",
        "ActiveModeMgr.cpp",
        "RealModeMgr.cpp",
        "FixedSizeModeMgr.cpp",
        "VariableModeMgr.cpp",
        "HwcDisplayPipe.cpp",
        "FixedDisplayPipe.cpp",
        "LoopbackDisplayPipe.cpp",
        "DualDisplayPipe.cpp",
        "MultiDisplayDrmPipe.cpp",
    ],

    static_libs: [
        "mesondisplay.common_static",
        "hwc.utils_static",
        "hwc.base_static",
        "hwc.display_static",
        "hwc.postprocessor_static",
    ],

    export_include_dirs: ["include"],
}
