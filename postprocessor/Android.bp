// *** THIS PACKAGE HAS SPECIAL LICENSING CONDITIONS.  PLEASE
//     CONSULT THE OWNERS AND opensource-licensing@google.com BEFORE
//     DEPENDING ON IT IN YOUR PROJECT. ***
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_hwcomposer_license"
    // to get the below license kinds:
    //   legacy_by_exception_only (by exception only)
    //   legacy_proprietary (by exception only)
    default_applicable_licenses: ["hardware_amlogic_hwcomposer_license"],
}

soong_config_module_type {
    name: "meson_hwc_postprocessor_defaults",
    module_type: "cc_defaults",
    config_namespace: "meson_hwc",

    bool_variables: [
        "enable_video_aisr",
        "enable_video_aipq",
        "enable_video_aiface",
        "enable_video_aicolor",
        "enable_video_di",
    ],

    properties: [
        "srcs",
        "shared_libs",
        "header_libs",
        "export_include_dirs",
    ],
}

meson_hwc_postprocessor_defaults {
    name: "hwcomposer_postprocessor_defaults",
    vendor: true,

    soong_config_variables: {
        enable_video_aisr: {
            srcs: [
                "nnprocess/NnProcessor.cpp",
                "nnprocess/sr_sdk.c",
            ],
            shared_libs: [
                "libion",
                "libui",
            ],
            header_libs: [
                "libnnsdk_headers",
            ],
            export_include_dirs: [
                "nnprocess",
            ]
        },
        enable_video_aipq: {
            srcs: [
                "nnprocess/AipqProcessor.cpp",
                "nnprocess/pq_sdk.c",
            ],
            shared_libs: [
                "libion",
                "libui",
            ],
            header_libs: [
                "libnnsdk_headers",
            ],
            export_include_dirs: [
                "nnprocess",
            ]
        },
        enable_video_aiface: {
            srcs: [
                "nnprocess/AiFaceProcessor.cpp",
                "nnprocess/face_sdk.c",
                "nnprocess/face_sdk_postprocess.c",

            ],
            shared_libs: [
                "libion",
                "libui",
            ],
        },
        enable_video_di: {
            srcs: [
                "nnprocess/DiProcessor.cpp",
            ],
            shared_libs: [
                "libui",
            ],
            export_include_dirs: [
                "nnprocess",
            ]
        },
        enable_video_aicolor: {
            srcs: [
                "nnprocess/AiColorProcessor.cpp",
                "nnprocess/color_sdk.c",

            ],
            shared_libs: [
                "libion",
                "libui",
            ],

            export_include_dirs: [
                "nnprocess",
            ]
        },
    },
}

cc_library_static {
    name: "hwc.postprocessor_static",
    defaults: ["hwcomposer_cc_defaults", "hwcomposer_postprocessor_defaults"],
    vendor: true,

    srcs: [
        "VdinPostProcessor.cpp",
        "common/Ge2dHelper.cpp",
        "fbprocessor/FbProcessor.cpp",
        "fbprocessor/DummyProcessor.cpp",
        "fbprocessor/CopyProcessor.cpp",
        "fbprocessor/CompositionProcessor.cpp",
        "common/WBGLHelper.cpp",
    ],

    static_libs: [
        "mesondisplay.common_static",
        "hwc.utils_static",
        "hwc.base_static",
        "hwc.display_static",
    ],

    export_include_dirs: [
        "include",
        "fbprocessor",
        "common",
    ],
}
